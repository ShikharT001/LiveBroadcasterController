# ==========================================
# OBS Bridge Configuration
# ==========================================

# Port where this bridge service will listen (4001 recommended on Windows)
PORT=4001

# OBS Studio WebSocket Settings (Default 4455 or configured port e.g. 4457)
OBS_HOST=127.0.0.1
OBS_PORT=4457
OBS_PASSWORD=YOUR_OBS_WEBSOCKET_PASSWORD

# Secret Authentication Token (Must match NEXT_PUBLIC_OBS_BRIDGE_SECRET in Next.js)
BRIDGE_SECRET=broadcaster-secure-secret-2025

# Allowed CORS origins (* allows second system on LAN to connect)
ALLOWED_ORIGINS=*
