# ==========================================
# Next.js Broadcast Controller Environment Variables
# ==========================================

# Supabase Database & Auth (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local OBS Bridge Connection
# URL of the local companion Node.js service running on the broadcast computer
NEXT_PUBLIC_OBS_BRIDGE_URL=http://localhost:4001

# Secret token shared with the OBS Bridge (must match BRIDGE_SECRET in obs-bridge/.env)
NEXT_PUBLIC_OBS_BRIDGE_SECRET=broadcaster-secure-secret-2025

# Base Application URL (used to generate Browser Source overlay links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
